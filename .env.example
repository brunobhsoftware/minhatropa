# MinhaTropa — modelo de configuração.
# Em produção o arquivo real fica FORA do public_html:
#   /home/u839930205/domains/minhatropa.com.br/.env.minhatropa
# (lido por bootstrap/app.php). Nunca commitar senhas.
APP_NAME="MinhaTropa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u839930205_minhatropa
DB_USERNAME=u839930205_tropauser
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mail (segunda etapa): contas da Hostinger noreply@ e atendimento@minhatropa.com.br.
# Sem configuração, os e-mails vão para o log.
MAIL_MAILER=log

# Arquivos enviados e sessões: fora do public_html em produção (a publicação reescreve o public_html).
# Em branco = storage/ (desenvolvimento).
MT_ARMAZENAMENTO=
